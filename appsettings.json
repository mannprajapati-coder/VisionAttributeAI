{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VisionAi": {
    "Yolo": {
      "ModelPath": "models/yolo/yolov5n.onnx",
      "InputWidth": 640,
      "InputHeight": 640,
      "ConfidenceThreshold": 0.35,
      "NmsThreshold": 0.45,
      "PersonClassId": 0
    },
    "Par": {
      "ModelPath": "models/par/pulc_person_attribute.onnx",
      "ClipModelPath": "models/par/fashion_clip_vision.onnx",
      "UseClipForAppearanceSex": true,
      "InputWidth": 192,
      "InputHeight": 256,
      "ConfidenceThreshold": 0.50,
      "Thresholds": {
        "AppearanceSex": 0.60,
        "AgeGroup": 0.50,
        "Orientation": 0.50,
        "SleeveType": 0.50,
        "LowerAttire": 0.50,
        "Hat": 0.50,
        "Glasses": 0.40,
        "Bags": 0.50,
        "Boots": 0.50,
        "ClothingPatterns": 0.50
      }
    },
    "LiveTracking": {
      "TargetFps": 2.0,
      "MaxMissedFrames": 10,
      "TrackTimeoutSeconds": 5.0,
      "MatchIouThreshold": 0.30,
      "MinDetectionConfidence": 0.40,
      "MinCropWidth": 40,
      "MinCropHeight": 80,
      "MinCropArea": 3200,
      "MinSharpnessVariance": 35.0,
      "HistoryWindowSize": 10,
      "MinValidObservations": 5,
      "AmbiguityMarginThreshold": 0.15
    },
    "PersonAnalysis": {
      "CameraProcessingFps": 2.0,
      "MinPersonConfidence": 0.40,
      "MinCropWidth": 40,
      "MinCropHeight": 80,
      "MinCropArea": 3200,
      "MinSharpness": 35.0,
      "MinKeypointConfidence": 0.35,
      "MinFeetWidth": 40,
      "MinFeetHeight": 25,
      "MinFeetSharpness": 15.0,
      "MinFeetPoseConfidence": 0.30,
      "WatchMinRoiWidth": 35,
      "WatchMinRoiHeight": 35,
      "WatchMinSharpness": 20.0,
      "WatchMinPoseConfidence": 0.35,
      "WatchDetectionConfidence": 0.50,
      "WatchRequiredStableObservations": 3,
      "WatchNegativeStableObservations": 5,
      "MinimumValidFrames": 5,
      "ObservationWindowSize": 10,
      "StableConfidenceThreshold": 0.60,
      "UnknownMarginThreshold": 0.12,
      "TrackExpirationSeconds": 5.0,
      "MaxMissedFrames": 10,
      "MatchIouThreshold": 0.30,
      "YoloModelPath": "models/yolo/yolov5n.onnx",
      "PoseModelPath": "models/pose/yolov8n-pose.onnx",
      "ClipVisionModelPath": "models/par/fashion_clip_vision.onnx",
      "ClipTextModelPath": "models/par/fashion_clip_text.onnx",
      "WatchModelPath": "models/watch/yolov8n-watch.onnx"
    },
    "BrandRecognition": {
      "Enabled": true,
      "LogosRetinaNetModelPath": "models/brand/logos_retinanet.onnx",
      "DinoV2ModelPath": "models/brand/dinov2_vits14.onnx",
      "GalleryPath": "models/brand/gallery",
      "MinPersonHeight": 180,
      "MinRegionDimension": 32,
      "MinLogoCropSize": 24,
      "DetectionConfidenceThreshold": 0.20,
      "DetectionNmsThreshold": 0.40,
      "MinCosineSimilarity": 0.40,
      "MinRunnerUpMargin": 0.02,
      "SampleIntervalFrames": 12,
      "RequiredStableObservations": 2
    }
  }
}
